# ========== OJ题解站环境变量配置 ==========

# 服务端口（默认 8766）
PORT=8766

# 登录密码（必填！上云前必须设置强密码）
USER_PASSWORD=你的用户密码
ADMIN_PASSWORD=你的管理员密码

# CORS 允许的来源（逗号分隔，* 表示允许所有）
# 上云时改为你的域名，例如：https://oj.example.com
CORS_ORIGINS=http://localhost:8765,http://localhost:8766

# ========== 爬虫 Cookie（运行时通过前端输入，不需要在这里设置） ==========
# LUOGU_COOKIE=（通过前端表单输入）
# DFBOY_COOKIE=（通过前端表单输入）
