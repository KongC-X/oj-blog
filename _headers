# Cloudflare Pages 响应头配置
# 生产环境（静态托管）没有 Node 服务，安全头在这里统一下发

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# 课件目录：独立自包含的教学页面，需要比全站更宽松的 CSP
#   1. 课件大量使用内联事件属性（onclick="toggleAnswer(this)" 等，共 1316 处），
#      而 script-src-attr 的优先级高于 script-src，必须单独放开 'unsafe-inline'；
#   2. 语法高亮已本地化到 /vendor/highlight/，因此不再需要任何外部域名白名单，
#      script-src / style-src 保持 'self'，这是目前唯一放宽项（内联事件）之外的严格策略。
# 注意：_headers 中同名头会被「逗号拼接」而不是覆盖（两条 CSP 头浏览器取交集，会更严格），
#      所以必须先用 ! 摘掉上面 /* 下发的 CSP，再重新设置，且该规则要放在 /* 之后。
/courseware/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# 字体与第三方库：文件名带版本语义，可长缓存
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# CSS / JS 由 index.html 的 ?v= 控制版本，可缓存 7 天
/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800

# 数据与题解正文：靠 ETag 协商缓存，保证更新后立刻可见
/data/*
  Cache-Control: public, max-age=0, must-revalidate

/solutions/*
  Cache-Control: public, max-age=0, must-revalidate

# 预渲染静态页：同样走协商缓存
/p/*
  Cache-Control: public, max-age=0, must-revalidate
